# Copy to .env and fill in. .env is git-ignored. Only needed to rerun experiments from scratch;
# regenerating the tables and figures (make tables / make figures) needs no key.
OPENAI_API_KEY=      # generator G and controller M (gpt-5.6-terra), both domains
ANTHROPIC_API_KEY=   # evaluator E in detoxification (claude-opus-5)
XAI_API_KEY=         # second judge (panel) in detoxification (grok-4.6)
HF_TOKEN=            # Hugging Face downloads; ShieldGemma is gated (accept the Gemma terms first)
